# Copy this file to `.env` and fill in your own key.
# `.env` is gitignored and must NEVER be committed.

# Required for eval/ — the LLM agent under test and the semantic verifier.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model used for the agent under test.
# Defaults to claude-opus-5. See eval/README.md on cost — a full multi-seed
# run over the whole corpus is thousands of calls, so use a cheaper model
# (claude-haiku-4-5) while iterating on the corpus itself.
# WARDEN_AGENT_MODEL=claude-opus-5

# --- Razorpay (src/tool/razorpay_api.py, `--rail razorpay`) ---
# Dashboard -> toggle TEST MODE ON -> Account & Settings -> API Keys ->
# Generate Key. The secret is shown EXACTLY ONCE; download it there and then.
# The client refuses to run unless the id starts with `rzp_test_`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- OpenRouter (cross-lab evaluation arm, ADR 0011) ---
# openrouter.ai/keys. Free-tier models cost $0 but still need an account.
OPENROUTER_API_KEY=

# --- Google AI Studio (the Gemini arm of ADR 0011) ---
# aistudio.google.com/apikey. Free tier is 20 requests PER DAY per model --
# not per minute. See docs/eval-findings.md on why the cross-lab arm is
# denial-only and n=1.
GOOGLE_API_KEY=

# --- Warden's own keys. BOTH OPTIONAL, both fail safe when unset. ---
# Signs the audit chain (ADR 0016). Unset = the log is written unsigned and
# verify_chain() says so in as many words, rather than reporting the same
# reassuring message for a weaker guarantee.
WARDEN_AUDIT_KEY=
# Keys the mandate signer (ADR 0012). Unset = a per-process random secret,
# which fails CLOSED across processes -- a mandate minted by one process will
# not verify in another.
WARDEN_MANDATE_KEY=
